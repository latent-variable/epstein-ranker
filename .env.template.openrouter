# Copy to .env.openrouter and fill in secrets/identifiers.
# This template is safe to commit.

# Required: OpenRouter API key.
OPENROUTER_API_KEY='sk-or-REPLACE_ME'

# Recommended by OpenRouter: identifying headers for your app/project.
# Mapped to HTTP-Referer and X-Title when using the OpenRouter endpoint.
OPENROUTER_REFERER='https://your-project-or-site.example'
OPENROUTER_TITLE='Epstein File Ranker'

# Optional: provider routing preference and fallback behavior.
OPENROUTER_PROVIDER='alibaba'
OPENROUTER_NO_FALLBACKS='1'
